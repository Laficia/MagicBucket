<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <AssemblyName>SrankFlag</AssemblyName>
    <Version>1.2.14.4</Version>
    <Authors>hunhuan</Authors>
    <Description>魔法水桶：原生窗口、条件时间订阅与主题适配。</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(APPDATA)\XIVLauncherCN\addon\Hooks\dev</DalamudLibPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(DalamudLibPath)</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Dalamud" Private="false" />
    <Reference Include="Dalamud.Bindings.ImGui" Private="false" />
    <Reference Include="Lumina.Excel" Private="false" />
    <Reference Include="Lumina" Private="false" />
    <Reference Include="FFXIVClientStructs" Private="false" />
    <Reference Include="InteropGenerator.Runtime" Private="false" />
    <Reference Include="KamiToolKit" HintPath="../../lib/KamiToolKit.dll" Private="true" />
    <Reference Include="FFXIVClientStructs.Expansion" HintPath="../../lib/FFXIVClientStructs.Expansion.dll" Private="true" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/hunt_conditions.json" LogicalName="SrankFlag.HuntConditions.json" />
    <None Update="SrankFlag.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/srank_data.json" Link="srank_data.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckDalamud" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(DalamudLibPath)/Dalamud.dll')" Text="Set DALAMUD_HOME or DalamudLibPath to your installed Dalamud SDK directory." />
  </Target>
</Project>
